---
import CartNotification from '@components/react/CartNotification.tsx'
import Header from '@components/react/Header.tsx'
import BottomNavAuth from '@components/react/BottomNavAuth.tsx'
import NotificationSystem from '@components/react/NotificationSystem.tsx'
import { AuthProvider } from '@components/react/AuthContext.tsx'
import { HeaderWrapper } from '@components/ui/HeaderWrapper.tsx'
import { BottomNavWrapper } from '@components/ui/BottomNavWrapper.tsx'
import { SimpleBottomNav } from '@components/ui/SimpleBottomNav.tsx'
import OneSignalSubscriber from '@components/react/OneSignalSubscriber.tsx'
import NotificationWelcome from '@components/react/NotificationWelcome.tsx'
import FloatingNotificationButton from '@components/react/FloatingNotificationButton.tsx'
import WelcomeGuide from '@components/react/WelcomeGuide.tsx'
import SearchGuide from '@components/react/SearchGuide.tsx'
import CategoryGuide from '@components/react/CategoryGuide.tsx'

export interface Props {
  title?: string
  description?: string
}

const { 
  title = "Town - Tu Tienda de Barrio Online",
  description = "Encuentra los mejores productos de tu barrio al mejor precio" 
} = Astro.props
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" href="/icon.png">
  <link rel="apple-touch-icon" href="/icon.png">
  
  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json">
  
  <!-- OneSignal Web Push SDK - Carga asíncrona para no bloquear -->
  <script>
    // Cargar OneSignal de forma asíncrona después de que la página cargue
    window.addEventListener('load', function() {
      setTimeout(function() {
        const script = document.createElement('script');
        script.src = 'https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
        script.defer = true;
        document.head.appendChild(script);
        
        window.OneSignalDeferred = window.OneSignalDeferred || [];
        OneSignalDeferred.push(async function(OneSignal) {
          try {
            await OneSignal.init({
              appId: "270896d8-ba2e-40bc-8f3b-c1e6efd258a1",
              allowLocalhostAsSecureOrigin: true,
            });
            console.log('✅ OneSignal inicializado');
          } catch (error) {
            console.log('⚠️ OneSignal no se pudo inicializar:', error);
          }
        });
      }, 1000); // Esperar 1 segundo después de la carga
    });
  </script>
  
  <!-- REDISEÑO VISUAL COMPLETO -->
  <link rel="stylesheet" href="/src/styles/global-redesign.css">
  
  <!-- FORZAR CAMBIOS UI -->
  <link rel="stylesheet" href="/src/styles/force-ui-override.css">
  
  <!-- FORZAR BOTTOM NAV VISIBLE -->
  <link rel="stylesheet" href="/styles/force-bottom-nav.css">
  
  <!-- ⭐ TEMA ROSA TOWNY - FORZADO CON !IMPORTANT -->
  <style>
    :root {
      /* 🌸 COLORES ROSA TOWNY */
      --towny-pink: #FF4D6A !important;
      --towny-pink-hover: #E6435D !important;
      --towny-pink-active: #CC3952 !important;
      
      /* Neutros cálidos (amables con fotos blancas) */
      --bg-app: #0F1115;              /* fondo app (oscuro, no negro puro) */
      --bg-surface: #151A21;          /* contenedores oscuros */
      --bg-paper: #F7F6F2;            /* "papel" para cards de producto */
      --border-soft: #E7E3DA;         /* borde sutil sobre paper */
      --muted: #9AA4B2;               /* textos secundarios */
      --text-primary: #FFFFFF;
      --text-inverse: #0E1116;

      /* Accentos - CAMBIADO A ROSA */
      --primary: #FF4D6A !important;  /* CTA principal (ROSA TOWNY) */
      --color-accent: #FF4D6A !important;
      --primary-600: #1D4ED8;
      --accent: #F97316;              /* badges/ofertas */
      --success: #10B981;
      --danger: #E11D48;
      --warning: #F59E0B;

      /* Radius & sombras */
      --radius: 16px;
      --shadow-elev: 0 8px 28px -12px rgba(0,0,0,.45);

      /* Tipografía */
      --font-sans: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, "Noto Sans", Arial, sans-serif;
    }

    /* Utilidades globales */
    .ui-container {
      max-width: 80rem;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .ui-section {
      padding: 2rem 0;
    }

    .ui-card {
      border-radius: var(--radius);
      box-shadow: var(--shadow-elev);
    }

    .ui-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius);
      padding: 0 1rem;
      height: 2.75rem;
      font-weight: 600;
      transition: all 0.2s;
      outline: none;
    }

    .ui-btn:focus {
      outline: none;
      box-shadow: 0 0 0 2px var(--primary);
    }

    /* 🌸 ROSA TOWNY SOLO EN BOTONES DE AGREGAR Y BOTTOM NAV */
    
    /* Botones de agregar al carrito en el feed */
    button[aria-label*="Agregar"],
    button[aria-label*="agregar"],
    button[aria-label*="Añadir"],
    button[aria-label*="carrito"],
    .add-to-cart-button,
    .add-button {
      background-color: #FF4D6A !important;
      color: white !important;
    }

    button[aria-label*="Agregar"]:hover,
    button[aria-label*="agregar"]:hover,
    .add-to-cart-button:hover,
    .add-button:hover {
      background-color: #E6435D !important;
    }

    /* Bottom nav activo */
    nav[class*="bottom"] .active,
    .bottom-nav .active,
    footer nav .active {
      color: #FF4D6A !important;
    }

    .ui-link {
      color: var(--primary);
      transition: color 0.2s;
    }

    .ui-link:hover {
      color: var(--primary-600);
    }

    /* Break-inside para masonry */
    .break-inside-avoid {
      break-inside: avoid;
    }

    /* Safe area para navbars */
    .ui-navbar-top {
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .ui-navbar-bottom {
      position: sticky;
      bottom: 0;
      z-index: 50;
      padding-bottom: env(safe-area-inset-bottom);
    }

    /* Focus visible mejorado */
    .ui-focus-visible {
      outline: none;
    }

    .ui-focus-visible:focus {
      box-shadow: 0 0 0 2px var(--primary);
    }

    /* Estados de botones */
    .ui-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Inputs con contraste correcto */
    .ui-input {
      background-color: white;
      color: var(--text-inverse);
    }

    .ui-input::placeholder {
      color: var(--muted);
    }

    .ui-input-dark {
      background-color: var(--bg-surface);
      color: var(--text-primary);
    }

    .ui-input-dark::placeholder {
      color: var(--muted);
    }
  </style>
  
  <!-- Importar CSS de prueba -->
  <link rel="stylesheet" href="/src/styles/test.css">
  
  <!-- Importar CSS específico del checkout -->
  <link rel="stylesheet" href="/src/styles/checkout.css">
  
  <!-- Importar CSS para restaurar estilos dañados -->
  <link rel="stylesheet" href="/src/styles/restore-styles.css">
  
  <!-- Importar CSS para forzar botones -->
  <link rel="stylesheet" href="/src/styles/force-buttons.css">
  
  <!-- Importar CSS para arreglar botones transparentes -->
  <link rel="stylesheet" href="/src/styles/fix-transparent-buttons.css">
  
  <!-- Importar CSS para arreglar botones de búsqueda -->
  <link rel="stylesheet" href="/src/styles/fix-search-buttons.css">
  
  <!-- Importar CSS para colores opacos del tema oscuro -->
  <link rel="stylesheet" href="/src/styles/dark-theme-colors.css">
  
  <!-- Fix para modal de login -->
  <link rel="stylesheet" href="/src/styles/modal-fix.css">
  
  <!-- Importar fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-dark-primary text-text-primary">
  <!-- Header Navigation -->
  <HeaderWrapper client:load />

  <!-- Contenido principal -->
  <main class="min-h-screen bg-dark-primary pt-[72px]">
    <AuthProvider client:load>
      <slot />
    </AuthProvider>
  </main>

  <!-- Bottom Navigation -->
  <BottomNavWrapper client:load />

  <!-- Notificaciones del carrito -->
  <CartNotification client:load />

  <!-- Sistema de notificaciones - Solo cargar cuando sea necesario -->
  <NotificationSystem client:idle />


  <!-- Footer -->
  <footer class="bg-bg-surface text-ink-base py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Información de la tienda -->
        <div class="col-span-1 md:col-span-2">
          <h3 class="text-xl font-bold mb-4">🏘️ Town</h3>
          <p class="text-gray-400 mb-4">
            Tu tienda de barrio online. Los mejores productos de tu comunidad 
            con la comodidad de comprar desde casa.
          </p>
        </div>

        <!-- Enlaces rápidos -->
        <div>
          <h4 class="font-semibold mb-4">Enlaces</h4>
          <ul class="space-y-2 text-gray-400">
            <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
            <li><a href="/catalogo" class="hover:text-white transition-colors">Catálogo</a></li>
            <li><a href="/carrito" class="hover:text-white transition-colors">Carrito</a></li>
          </ul>
        </div>

        <!-- Contacto -->
        <div>
          <h4 class="font-semibold mb-4">Contacto</h4>
          <ul class="space-y-2 text-gray-400">
            <li>📧 info@tienda.com</li>
            <li>📱 +1 234 567 8900</li>
            <li>📍 Ciudad, País</li>
          </ul>
        </div>
      </div>

      <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400">
        <p>&copy; {new Date().getFullYear()} Town. Todos los derechos reservados.</p>
      </div>
    </div>
  </footer>

  <!-- Manejador global de inicio de sesión -->
  
  <!-- Suscriptor automático de OneSignal - Solo cuando sea necesario -->
  <OneSignalSubscriber client:idle />
  
  <!-- Modal de bienvenida de notificaciones - Solo cuando sea necesario -->
  <NotificationWelcome client:idle />
  
  <!-- Botón flotante para activar notificaciones - Solo cuando sea necesario -->
  <FloatingNotificationButton client:idle />
  
  <!-- Guía de bienvenida para nuevos usuarios -->
  <WelcomeGuide client:idle />
  
  <!-- Guía contextual de búsqueda -->
  <SearchGuide client:idle />
  
  <!-- Guía contextual de categorías -->
  <CategoryGuide client:idle />
  
  <!-- Script para sincronizar género desde Google - Optimizado -->
  <script>
    // Solo ejecutar si el usuario está autenticado
    if (typeof window !== 'undefined') {
      // Ejecutar después de que la página cargue completamente
      window.addEventListener('load', function() {
        setTimeout(async function() {
          try {
            const { supabase } = await import('../lib/supabase-browser');
            const { data: { user } } = await supabase.auth.getUser();
            
            if (!user) return;
            
            // Solo sincronizar si el usuario tiene gender en metadata y no se ha sincronizado antes
            const googleGender = user.user_metadata?.gender;
            const lastSync = localStorage.getItem('gender_sync_' + user.id);
            
            if (googleGender && !lastSync) {
              try {
                const { error } = await supabase
                  .from('profiles')
                  .update({ gender: googleGender })
                  .eq('id', user.id);
                
                if (!error) {
                  localStorage.setItem('gender_sync_' + user.id, 'true');
                  console.log('✅ Género sincronizado desde Google:', googleGender);
                }
              } catch (err) {
                console.log('⚠️ Columna gender no existe aún');
              }
            }
          } catch (error) {
            console.log('⚠️ Error sincronizando género:', error);
          }
        }, 2000); // Esperar 2 segundos después de la carga
      });
    }
  </script>

  <!-- Script para testing de la guía de bienvenida -->
  <script>
    if (typeof window !== 'undefined') {
      // Función para resetear la guía de bienvenida (solo para testing)
      window.resetWelcomeGuide = function() {
        localStorage.removeItem('town_first_login');
        console.log('✅ Guía de bienvenida reseteada. Recarga la página y loguéate para verla.');
      };
      
      // Función para simular login (solo para testing)
      window.simulateFirstLogin = function() {
        localStorage.setItem('auth-state', 'authenticated');
        localStorage.removeItem('town_first_login');
        window.dispatchEvent(new CustomEvent('auth-state-changed'));
        console.log('✅ Simulando primer login. La guía debería aparecer.');
      };
      
      // Función para resetear la guía de búsqueda (solo para testing)
      window.resetSearchGuide = function() {
        localStorage.removeItem('town_first_search');
        console.log('✅ Guía de búsqueda reseteada. Haz click en la barra de búsqueda para verla.');
      };
      
      // Función para mostrar la guía de búsqueda manualmente (solo para testing)
      window.showSearchGuide = function() {
        window.dispatchEvent(new CustomEvent('show-search-guide'));
        console.log('✅ Mostrando guía de búsqueda.');
      };
      
      // Función para resetear la guía de categorías (solo para testing)
      window.resetCategoryGuide = function() {
        localStorage.removeItem('town_category_guide_shown');
        console.log('✅ Guía de categorías reseteada. Haz scroll hasta las categorías para verla.');
      };
      
      // Función para mostrar la guía de categorías manualmente (solo para testing)
      window.showCategoryGuide = function() {
        const comidaCard = document.querySelector('[data-category="comida"]');
        if (comidaCard) {
          comidaCard.classList.add('guide-highlight');
          // Hacer scroll a la categoría
          comidaCard.scrollIntoView({ 
            behavior: 'smooth', 
            block: 'center' 
          });
        }
        setTimeout(() => {
          window.dispatchEvent(new CustomEvent('show-category-guide'));
          console.log('✅ Mostrando guía de categorías.');
        }, 500);
      };
      
      console.log('🔧 Funciones de testing disponibles:');
      console.log('  - resetWelcomeGuide(): Resetea la guía de bienvenida');
      console.log('  - simulateFirstLogin(): Simula un primer login');
      console.log('  - resetSearchGuide(): Resetea la guía de búsqueda');
      console.log('  - showSearchGuide(): Muestra la guía de búsqueda manualmente');
      console.log('  - resetCategoryGuide(): Resetea la guía de categorías');
      console.log('  - showCategoryGuide(): Muestra la guía de categorías manualmente');
    }
  </script>

  <!-- Script para detectar scroll y mostrar guía de categorías -->
  <script>
    if (typeof window !== 'undefined') {
      let categoryGuideShown = false;
      let scrollTimeout;
      let debugMode = true; // Para ver logs de debug

      function checkCategoryGuide() {
        // Solo mostrar si no se ha mostrado antes
        const hasShownBefore = localStorage.getItem('town_category_guide_shown');
        if (hasShownBefore || categoryGuideShown) {
          if (debugMode && hasShownBefore) {
            console.log('🔕 Guía de categorías ya fue mostrada antes');
          }
          return;
        }

        // Buscar el título "Explora por Categoría" específicamente
        const categoryTitle = document.getElementById('category-title');
        const header = document.querySelector('header');
        
        if (!categoryTitle) {
          if (debugMode) {
            console.log('⚠️ No se encontró el título de categorías (#category-title)');
          }
          return;
        }

        const headerHeight = header ? header.offsetHeight : 80;
        
        // Obtener la posición del elemento
        const rect = categoryTitle.getBoundingClientRect();
        
        if (debugMode) {
          console.log('📏 Posición del título:', {
            top: rect.top,
            headerHeight: headerHeight,
            isInRange: rect.top <= headerHeight + 150
          });
        }
        
        // Verificar si el título está al nivel del header o ya pasó
        // Ampliado el rango para que sea más fácil de activar
        const isAtHeaderLevel = rect.top <= headerHeight + 150 && rect.top >= -100;
        
        if (isAtHeaderLevel) {
          console.log('✅ ¡Activando guía de categorías!');
          
          // Marcar como mostrado
          categoryGuideShown = true;
          localStorage.setItem('town_category_guide_shown', 'true');
          
          // Destacar la categoría Comida
          const comidaCard = document.querySelector('[data-category="comida"]');
          if (comidaCard) {
            comidaCard.classList.add('guide-highlight');
            console.log('🎯 Categoría Comida destacada');
            
            // Hacer scroll suave a la categoría Comida si no está visible
            setTimeout(() => {
              comidaCard.scrollIntoView({ 
                behavior: 'smooth', 
                block: 'center' 
              });
            }, 100);
          } else {
            console.warn('⚠️ No se encontró la categoría Comida');
          }
          
          // Disparar evento para mostrar la guía
          setTimeout(() => {
            window.dispatchEvent(new CustomEvent('show-category-guide'));
            console.log('📍 Guía de categorías activada por scroll');
          }, 300);
        }
      }

      // Escuchar evento de scroll con throttling
      window.addEventListener('scroll', function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(checkCategoryGuide, 50);
      }, { passive: true });

      // Verificar al cargar la página
      window.addEventListener('load', function() {
        console.log('🚀 Script de guía de categorías cargado');
        setTimeout(checkCategoryGuide, 2000);
      });

      // Verificar cada 2 segundos por si el elemento aparece después
      let checkInterval = setInterval(function() {
        const categoryTitle = document.getElementById('category-title');
        if (categoryTitle) {
          console.log('✅ Título de categorías encontrado, iniciando detección de scroll');
          clearInterval(checkInterval);
        }
      }, 500);
    }
  </script>
</body>
</html>